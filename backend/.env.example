# Backend environment (copy to .env — never commit .env)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/meeting_ba
# SQLite for local dev/tests:
# DATABASE_URL=sqlite+aiosqlite:///./dev.db

SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json
GITHUB_TOKEN=

MODEL_POLICY_PATH=config/model_policy.yaml
CONNECTORS_PATH=config/connectors.yaml
PROFILES_DIR=profiles

# 1 = FakeLLM (dev/test offline — không cần API key)
LLM_FAKE=0
# Provider thật khi LLM_FAKE=0
LLM_REAL=anthropic
