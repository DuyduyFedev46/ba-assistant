# Backend API (mặc định http://localhost:8000)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Firebase Auth — dev không cần set (backend local chạy AUTH_DISABLED=1). Prod bắt buộc.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=ba-assistant-portal.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=ba-assistant-portal
